# Database settings shared by Docker Compose and the backend. Copy to .env and
# choose a strong DATABASE_PASSWORD. It may contain URL-reserved characters.
DATABASE_NAME=whatsapp_ai_commerce
DATABASE_USER=whatsapp_ai_commerce
DATABASE_PASSWORD=
DATABASE_PORT=5432
BACKEND_PORT=8000
ENVIRONMENT=development

# WhatsApp: configure before using webhooks/outbound messages; never commit secrets.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Explicitly choose a supported Meta Graph API version (format vNN.N).
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=

# AI replies: choose a Responses API text model available to your OpenAI project.
# Missing key/model uses the safe acknowledgment fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=512
AI_HISTORY_MAX_MESSAGES=12
AI_HISTORY_MAX_CHARS=12000

# Step 5.3: a separate lightweight structured-output classifier model.
AI_CLASSIFIER_MODEL=gpt-4.1-nano
AI_CLASSIFIER_TIMEOUT_SECONDS=8
AI_CLASSIFIER_MAX_OUTPUT_TOKENS=256
AI_MAX_INPUT_CHARS=2000
AI_INBOUND_PER_MINUTE=10
AI_CUSTOMER_ATTEMPTS_PER_HOUR=60
AI_CUSTOMER_ATTEMPTS_PER_DAY=200
AI_BUSINESS_ATTEMPTS_PER_DAY=1000
AI_SPAM_THRESHOLD=3
AI_SPAM_WINDOW_SECONDS=60
AI_NOTICE_COOLDOWN_SECONDS=60
WHATSAPP_MAX_BODY_BYTES=1048576
# Single business/catalog per database. All variant prices use this currency.
CATALOG_CURRENCY=MAD
# COD checkout: ask only for configured fields missing from trusted/customer data.
CHECKOUT_REQUIRED_FIELDS='["customer_name","phone","city","address"]'
CHECKOUT_COUNTRY=MA
# Verified delivery facts only. Unset/disabled means no ETA or contact promise.
# DELIVERY_POLICY='{"enabled":true,"eta_min_days":1,"eta_max_days":2,"contact_before_arrival":false}'
# Direct backend only: leave unset when delivery fees are unknown (not free).
# For Docker, set CHECKOUT_SHIPPING_COST in backend.environment via an override.
# CHECKOUT_SHIPPING_COST=25.00
